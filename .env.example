# Copy to .env and fill in. Never commit .env.

# Public hostname (DNS A/AAAA must point at this VM). Caddy obtains a Let's
# Encrypt certificate for it. Use "localhost" for a local trial (internal CA).
REALM_DOMAIN=realm.example.com

# Absolute path to YOUR 1.12.1 client's Data/ folder on this VM (read-only).
# The package never ships or downloads game data.
CLIENT_DATA=/srv/client/Data

# Database passwords. Generate with: openssl rand -hex 24
DB_ROOT_PASSWORD=change-me
DB_MANGOS_PASSWORD=change-me
DB_REALMWEB_PASSWORD=change-me

# Image tags (CI publishes sha-* and latest).
MANGOS_TAG=latest
REALM_TAG=latest

# Generate movement maps during `realmctl extract` (hours of CPU; bots and
# NPC pathing are much better with them). 0 = skip.
EXTRACT_MMAPS=0
