# Pinned upstream revisions. realmctl and CI read this file; the Dockerfiles take
# them as build-args. Bump deliberately and rebuild the images.
MANGOS_CLASSIC_COMMIT=de8f72993b9e1faa1bf92dd5505f3daec5cea3ce
CLASSIC_DB_COMMIT=4d230bb1bd477948cac61c107d2718b3ea04a5b8
# github.com/cmangos/playerbots, dropped into src/modules/PlayerBots; moves with the core pin.
PLAYERBOTS_COMMIT=31e0f32b543fee46941db51225bb7b432eace236
WENILLA_REPO=https://github.com/Arnesen/wenilla
# A full commit hash, never a branch name — branch names are not reproducible builds.
# This one is the head of `soundscape-off-the-frame`, NOT of `main`: the browser's zone
# soundscape used to fetch and decode its music and ambience beds synchronously on the main
# thread, so every zone line and doorway froze the frame for ~200 ms plus a download (measured
# 220 ms over loopback alone). Arnesen/wenilla#14 has the diagnosis; it is closed unmerged
# because upstream syncing force-resets `main`, so the fix is pinned from its branch instead.
# **Do not delete that branch** — realm.Dockerfile reaches this commit with a full `git clone`
# plus `git checkout`, which resolves a branch commit only while the ref exists.
WENILLA_COMMIT=f41fa747eb58bb922de08b05d8487d794882dd53
