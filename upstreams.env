# Pinned upstream revisions. realmctl and CI read this file; the Dockerfiles take
# them as build-args. Bump deliberately and rebuild the images.
MANGOS_CLASSIC_COMMIT=de8f72993b9e1faa1bf92dd5505f3daec5cea3ce
CLASSIC_DB_COMMIT=4d230bb1bd477948cac61c107d2718b3ea04a5b8
# github.com/cmangos/playerbots, dropped into src/modules/PlayerBots; moves with the core pin.
PLAYERBOTS_COMMIT=31e0f32b543fee46941db51225bb7b432eace236
WENILLA_REPO=https://github.com/Arnesen/wenilla
# A full commit hash, never a branch name — branch names are not reproducible builds.
# This is the head of wenilla's `main`. wenilla's bump-realm-pin.yml rewrites the line below on
# every push to `main` and refuses a commit that does not descend from the current pin, so do
# not hand-edit it to anything off `main`: land the change on `main` and let the pin follow.
# Every carry (the browser port, the JavaScript bridge, the wasm-only fixes) lives on `main`,
# and upstream benilla is merged into `main`, so "the pin is current" means "upstream's latest
# plus our carries". The flow, and how it once drifted: docs/RELEASE.md.
WENILLA_COMMIT=c3a948ecaac7b49c5f1c272f3b2601e2f58ceced
