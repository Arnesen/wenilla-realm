#!/usr/bin/env bash
# realmctl — operator CLI for wenilla-realm (wraps docker compose v2).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
# shellcheck disable=SC1091
[ -f upstreams.env ] && set -a && . ./upstreams.env && set +a
# shellcheck disable=SC1091
[ -f .env ] && set -a && . ./.env && set +a

dc() { docker compose "$@"; }
die() { echo "realmctl: $*" >&2; exit 1; }
need_env() { [ -f .env ] || die "no .env — run ./realmctl init"; }

usage() {
  cat <<'USAGE'
usage: realmctl <command>
  init               guided first-time configuration: writes .env, explains each choice
                     (flags for scripting: --domain D --client-data DIR --mmaps 0|1 --yes)
  up                 start the stack, wait for the realm service, print the setup token
  down               stop everything (mangosd saves characters first; up to 5 min)
  status             compose ps + restart counts
  logs [svc]         follow logs (all services by default)
  extract [--mmaps]  extract dbc/maps/vmaps[/mmaps] from CLIENT_DATA into the gamedata volume
  import-datapack D  copy an existing dbc/ maps/ vmaps/ [mmaps/] tree into the gamedata volume
  backup             dump DBs + service state to backups/ (keeps 14)
  restore FILE       restore a backups/realm-*.tar.gz (stops the game services first)
  reset-admin        reset the web admin credentials
  update             pull newer images and restart
  install-cron       install a nightly backup crontab line
USAGE
}

setup_token() {
  local t
  t="$(dc exec -T realm cat /state/setup-token 2>/dev/null || true)"
  [ -n "${t}" ] || t="$(dc logs --no-color realm 2>/dev/null | sed -n 's/.*SETUP TOKEN: *\([A-Za-z0-9._-]*\).*/\1/p' | tail -1)"
  if [ -n "${t}" ]; then
    echo; echo "Setup: https://${REALM_DOMAIN:-localhost}/setup"; echo "Token: ${t}"
  else
    echo "(no setup token found — setup already completed, or run: realmctl logs realm)"
  fi
}

wait_healthy() {
  local svc="$1" secs="${2:-300}" cid st
  for _ in $(seq 1 "${secs}"); do
    cid="$(dc ps -q "${svc}" 2>/dev/null || true)"
    st="$( [ -n "${cid}" ] && docker inspect -f '{{.State.Health.Status}}' "${cid}" 2>/dev/null || echo starting)"
    [ "${st}" = "healthy" ] && return 0
    sleep 1
  done
  return 1
}

cmd_up() {
  need_env
  [ -n "${CLIENT_DATA:-}" ] && [ -d "${CLIENT_DATA}" ] || die "CLIENT_DATA (${CLIENT_DATA:-unset}) is not a directory"
  ls "${CLIENT_DATA}"/*.[Mm][Pp][Qq] >/dev/null 2>&1 || ls "${CLIENT_DATA}"/*/*.[Mm][Pp][Qq] >/dev/null 2>&1 \
    || die "no .MPQ files under ${CLIENT_DATA} — point it at your client's Data/ folder"
  for v in DB_ROOT_PASSWORD DB_MANGOS_PASSWORD DB_REALMWEB_PASSWORD; do
    [ "${!v:-change-me}" != "change-me" ] || die "set ${v} in .env (openssl rand -hex 24)"
  done
  local vol; vol="$(basename "${ROOT}")_gamedata"
  if ! docker volume inspect "${vol}" >/dev/null 2>&1; then
    echo "note: no game data yet — the world server will WAIT until you run 'realmctl extract'"
    echo "      or 'realmctl import-datapack' (movement maps included; the server requires them)."
  elif ! docker run --rm -v "${vol}:/data" debian:bookworm-slim bash -c 'ls /data/mmaps/*.mmap >/dev/null 2>&1'; then
    echo "note: game data has NO movement maps (mmaps) — the world server requires them and will"
    echo "      wait. Generate: 'realmctl extract' (hours on a small VM) or copy from a machine"
    echo "      that has them: 'realmctl import-datapack <dir>' — then 'docker compose restart mangosd'."
  fi
  if ! dc pull --quiet 2>/dev/null; then
    echo "note: image pull failed — no network, or the packages are private (then: docker login ghcr.io with a token that has read:packages). Trying with local images."
  fi
  dc up -d
  echo "waiting for the realm service..."
  wait_healthy realm 300 || echo "realm service not healthy yet; check: realmctl logs realm"
  setup_token
  echo
  echo "The world server loads for several minutes on first boot: watch 'realmctl status' and"
  echo "finish the /setup wizard AFTER mangosd shows healthy (its final step talks to the world"
  echo "server and will ask you to retry if you are early)."
}

# ---------------------------------------------------------------------------
# init — the guided configuration. Asks the few things only the operator knows,
# checks what it can, explains the limits where they matter, and writes .env.
# ---------------------------------------------------------------------------
ask() { # ask VAR "prompt" "default"
  local var="$1" prompt="$2" def="${3:-}" ans
  if [ "${YES}" = 1 ]; then printf -v "${var}" '%s' "${def}"; return; fi
  if [ -n "${def}" ]; then read -r -p "${prompt} [${def}]: " ans; else read -r -p "${prompt}: " ans; fi
  printf -v "${var}" '%s' "${ans:-${def}}"
}
yesno() { # yesno "question" default(y|n)
  local def="${2:-n}" ans
  if [ "${YES}" = 1 ]; then [ "${def}" = y ]; return; fi
  read -r -p "$1 [$( [ "${def}" = y ] && echo Y/n || echo y/N )]: " ans
  ans="${ans:-${def}}"; [[ "${ans}" =~ ^[Yy] ]]
}
rand_hex() { openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
hr() { printf '\n\033[2m%s\033[0m\n' "────────────────────────────────────────────────────────────────"; }
say() { printf '%s\n' "$@"; }

cmd_init() {
  local YES=0 domain="" client="" mmaps="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="$2"; shift 2 ;;
      --client-data) client="$2"; shift 2 ;;
      --mmaps) mmaps="$2"; shift 2 ;;
      --yes) YES=1; shift ;;
      --force) force=1; shift ;;
      *) die "init: unknown flag $1" ;;
    esac
  done
  # Writing .env needs no docker; 'up' does. Warn now so it is not a surprise later.
  if ! command -v docker >/dev/null; then say "warning: docker is not installed — 'realmctl up' needs Docker Engine + the compose plugin (https://docs.docker.com/engine/install/)"
  elif ! docker compose version >/dev/null 2>&1; then say "warning: 'docker compose version' fails — install the compose plugin before 'realmctl up'"; fi

  if [ -f .env ] && [ "${force}" = 0 ]; then
    say ".env already exists."
    yesno "Replace it? (the old one is kept as .env.bak)" n || { say "keeping .env — run ./realmctl up"; return 0; }
    cp .env .env.bak
  fi

  hr
  say "wenilla-realm — first-time setup" ""
  say "What you are setting up: ONE game world, played only from a browser, for a closed group." \
      "You will be the admin; you create every player account by hand (no self-registration)." \
      "Only ports 80/443 are ever exposed. The game data comes from a 1.12.1 client YOU own —" \
      "this package contains none and downloads none, and the archives never leave this machine." \
      "" \
      "Limits to know now: one world per install · WebGPU browsers only (Chrome/Edge; Linux Chrome" \
      "needs chrome://flags/#enable-unsafe-webgpu) · no phones · Discord sign-in is not in this" \
      "version · keep it unlisted and non-commercial (docs/LEGAL.md)."
  [ "${YES}" = 1 ] || { read -r -p "Enter to continue, Ctrl-C to stop: " _; }

  # --- 1. domain -------------------------------------------------------------
  hr; say "1/4  Address" ""
  say "The hostname players will open. HTTPS is mandatory (the browser exposes WebGPU only on a" \
      "secure origin), so Caddy fetches a Let's Encrypt certificate for this name at first start —" \
      "the DNS A record must already point at this machine and ports 80/443 must be reachable." \
      "For a trial on this laptop answer 'localhost' (self-signed; the browser warns once)."
  while :; do
    [ -n "${domain}" ] || ask domain "Hostname" "localhost"
    domain="${domain#https://}"; domain="${domain%%/*}"
    if [ "${domain}" = "localhost" ]; then say "  trial mode: https://localhost with Caddy's internal CA"; break; fi
    if [[ ! "${domain}" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]]; then say "  that does not look like a hostname"; domain=""; [ "${YES}" = 1 ] && die "bad --domain"; continue; fi
    local ip; ip="$( (getent ahostsv4 "${domain}" 2>/dev/null || true) | awk 'NR==1{print $1}')"
    if [ -n "${ip}" ]; then say "  ${domain} resolves to ${ip}"; else say "  warning: ${domain} does not resolve yet — Caddy cannot get a certificate until it does"; fi
    break
  done

  # --- 2. client data --------------------------------------------------------
  hr; say "2/4  Your client's Data folder" ""
  say "The Data/ directory of a 1.12.1 (build 5875) client, on this machine. It is mounted" \
      "read-only: the extractor reads it once to derive maps, and the realm service serves" \
      "single files out of the archives to your players' browsers." \
      "Not here yet?  rsync -a \"/path/to/client/Data/\" $(hostname):/srv/client/Data/"
  while :; do
    [ -n "${client}" ] || ask client "Path to Data/" "/srv/client/Data"
    client="${client%/}"
    if [ ! -d "${client}" ]; then say "  no such directory: ${client}"; [ "${YES}" = 1 ] && die "bad --client-data"; client=""; continue; fi
    local n; n="$(find "${client}" -maxdepth 2 -iname '*.mpq' 2>/dev/null | wc -l)"
    if [ "${n}" = 0 ]; then say "  no .MPQ archives found under ${client} — is this the Data folder?"; [ "${YES}" = 1 ] && die "no MPQs"; client=""; continue; fi
    say "  found ${n} archives ($(du -sh "${client}" 2>/dev/null | cut -f1))"
    [ -e "${client}/dbc.MPQ" ] || [ -e "${client}/enUS/patch.MPQ" ] || [ -e "${client}/patch.MPQ" ] || say "  note: no dbc.MPQ/patch.MPQ at the usual places — the extractor will tell if this is not a 5875 client"
    break
  done

  # --- 3. passwords -----------------------------------------------------------
  hr; say "3/4  Database passwords" ""
  local p_root p_mangos p_web; p_root="$(rand_hex)"; p_mangos="$(rand_hex)"; p_web="$(rand_hex)"
  say "Three MariaDB accounts get random passwords now (root for installs and backups; 'mangos'" \
      "for the game servers; 'realmweb', read-only, for the admin service). The database is never" \
      "reachable from outside the compose network — this is defence in depth, and it costs nothing." \
      "They are stored in .env (mode 600); you never type them."

  # --- 4. map data --------------------------------------------------------------
  hr; say "4/4  Server map data" ""
  say "The game server needs dbc/, maps/, vmaps/ AND movement maps (mmaps/) derived from your" \
      "client — ALL of them are required; the server will not start without movement maps." \
      "Two ways to get them, once:" \
      "  a) generate here: './realmctl extract' — dbc/maps/vmaps take ~20 min, movement maps" \
      "     add HOURS on a small VM (fine to leave running overnight)" \
      "  b) generate or reuse them on a beefier machine and copy the tree in:" \
      "     './realmctl import-datapack <dir with dbc/ maps/ vmaps/ mmaps/>'"
  if [ -z "${mmaps}" ]; then
    if yesno "Will you generate everything on THIS machine with 'realmctl extract'?" y; then mmaps=1; else mmaps=0; say "  ok — extract here would skip mmaps ('extract --no-mmaps'); plan to import the full tree."; fi
  fi

  # --- memory --------------------------------------------------------------------
  local ram_mb mangosd_mem
  ram_mb="$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
  if [ "${ram_mb}" -gt 0 ] && [ "${ram_mb}" -lt 6000 ]; then mangosd_mem="2500m"; else mangosd_mem="3g"; fi
  say "" "This machine has ${ram_mb} MB of RAM. Random bots are OFF by default (each one costs ~20 MB in" \
      "the world server; 50 bots ≈ 1 GB). The world server is capped at ${mangosd_mem}; the dashboard shows" \
      "memory pressure, and you can raise the cap in .env (MANGOSD_MEM) on a bigger VM."
  [ "${ram_mb}" -gt 0 ] && [ "${ram_mb}" -lt 3500 ] && say "  warning: under 4 GB is below what the world server needs; expect trouble."

  # --- write -------------------------------------------------------------------
  hr; say "Summary" "" "  domain        ${domain}" "  client data   ${client}" "  map data      $( [ "${mmaps}" = 1 ] && echo 'generate here (incl. mmaps)' || echo 'import from another machine')" ""
  [ "${YES}" = 1 ] || yesno "Write .env?" y || die "aborted; nothing written"
  umask 077
  cat > .env <<ENV
# Written by 'realmctl init' on $(date -u +%FT%TZ). Never commit this file.
REALM_DOMAIN=${domain}
CLIENT_DATA=${client}
DB_ROOT_PASSWORD=${p_root}
DB_MANGOS_PASSWORD=${p_mangos}
DB_REALMWEB_PASSWORD=${p_web}
MANGOS_TAG=latest
REALM_TAG=latest
EXTRACT_MMAPS=${mmaps}
MANGOSD_MEM=${mangosd_mem}
ENV
  say ".env written (mode 600)." ""
  local step1="  ./realmctl extract        # derive ALL the server's map data (once; mmaps take hours)"
  [ "${mmaps}" = 1 ] || step1="  ./realmctl import-datapack <dir>   # copy dbc/ maps/ vmaps/ mmaps/ from your other machine"
  say "Next:" \
      "${step1}" \
      "  ./realmctl up             # start everything; prints the SETUP TOKEN" \
      "  ./realmctl status         # wait here until mangosd is healthy (first load: minutes)" \
      "  https://${domain}/setup   # paste the token, name the realm, create your admin login" \
      "Then Users → 'Invite a friend', and send them https://${domain}/." ""
  say "Not automated: the DNS record, copying your client to this machine, and reading docs/LEGAL.md."
}

cmd_status() {
  dc ps
  echo; echo "restarts:"
  for cid in $(dc ps -aq); do
    docker inspect -f '  {{.Name}}  restarts={{.RestartCount}}  health={{if .State.Health}}{{.State.Health.Status}}{{else}}n/a{{end}}' "${cid}"
  done
}

cmd_extract() {
  need_env
  # Movement maps are REQUIRED by the world server (it will not start without them), so the
  # default is to generate them — hours of CPU on a small VM. --no-mmaps skips them for a
  # split workflow (generate elsewhere, then import-datapack).
  local mm=1
  case "${1:-}" in
    --no-mmaps) mm=0 ;;
    --mmaps|"") ;;
    *) die "extract: unknown flag ${1}" ;;
  esac
  EXTRACT_MMAPS="${mm}" dc --profile extract run --rm extract
}

cmd_import() {
  local src="${1:?usage: realmctl import-datapack <dir with any of dbc/ maps/ vmaps/ mmaps/>}"
  local have=()
  for d in dbc maps vmaps mmaps; do [ -d "${src}/${d}" ] && have+=("${d}"); done
  [ "${#have[@]}" -gt 0 ] || die "${src} has none of dbc/ maps/ vmaps/ mmaps/"
  echo "importing: ${have[*]}"
  local vol; vol="$(basename "${ROOT}")_gamedata"
  docker volume create "${vol}" >/dev/null
  tar -C "${src}" -cf - "${have[@]}" \
    | docker run --rm -i -v "${vol}:/data" debian:bookworm-slim \
        bash -c 'tar -C /data -xf - && date -u +%FT%TZ > /data/.extracted && chown -R 10001:10001 /data && du -sh /data/* | sed "s/^/  /"'
}

cmd_backup() { need_env; mkdir -p backups; dc --profile backup run --rm backup; }

cmd_restore() {
  need_env
  local f="${1:?usage: realmctl restore backups/realm-<stamp>.tar.gz}"
  [ -f "${f}" ] || die "no such file: ${f}"
  echo "stopping game services (characters are saved first)..."
  dc stop realm mangosd realmd
  dc --profile backup run --rm backup /opt/realm/restore.sh "/backups/$(basename "${f}")"
  dc up -d
}

cmd_install_cron() {
  local line="17 4 * * * ${ROOT}/realmctl backup >> ${ROOT}/backups/cron.log 2>&1"
  echo "${line}"
  if [ "${1:-}" = "--print" ]; then return; fi
  ( crontab -l 2>/dev/null | grep -v 'realmctl backup' ; echo "${line}" ) | crontab -
  echo "installed (crontab -l to verify)"
}

case "${1:-}" in
  init)            shift; cmd_init "$@" ;;
  up)              cmd_up ;;
  down)            dc down ;;
  status)          cmd_status ;;
  logs)            shift; dc logs -f --tail=200 "$@" ;;
  extract)         shift; cmd_extract "$@" ;;
  import-datapack) shift; cmd_import "$@" ;;
  backup)          cmd_backup ;;
  restore)         shift; cmd_restore "$@" ;;
  reset-admin)     dc exec realm /app/wenilla-realm reset-admin ;;
  update)          need_env; dc pull; dc up -d; cmd_status ;;
  install-cron)    shift; cmd_install_cron "$@" ;;
  ""|-h|--help|help) usage ;;
  *)               usage; exit 1 ;;
esac
